{
  "name": "assets-studio-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "api-types": "openapi-typescript ../build/openapi.json -o src/api/schema.ts",
    "e2e": "node e2e/smoke.mjs"
  },
  "dependencies": {
    "@google/model-viewer": "4.3.1",
    "@preact/signals": "2.11.2",
    "preact": "10.29.8",
    "three": "0.183.2",
    "wavesurfer.js": "8.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@preact/preset-vite": "2.10.6",
    "eslint": "10.11.0",
    "openapi-typescript": "7.13.0",
    "playwright-core": "1.63.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1"
  }
}
