set shell := ["bash", "-euo", "pipefail", "-c"]

# Heavy files live outside the Dropbox-synced working copy.
cache := env("XDG_CACHE_HOME", env("HOME") / ".cache") / "assets-studio"
source := cache / "mocapanything-source"
revision := `sed -n 's/^SOURCE_REVISION = "\([0-9a-f]*\)".*/\1/p' src/mocapanything_model_server/server.py`

export UV_PROJECT_ENVIRONMENT := cache / "venvs/mocapanything"
export MOCAPANYTHING_SOURCE := source
export HF_HUB_DISABLE_TELEMETRY := "1"

gpu_shell := "nix develop " + quote(justfile_directory() / "../../..") + "#assets-studio-gpu --command"

# Show the available commands
default:
    @just --justfile {{ justfile() }} --list

# Fetch the pinned MoCapAnything source and create the environment
setup:
    if [[ ! -d "{{ source }}/.git" ]]; then \
        git clone --no-checkout https://github.com/phongdaot/MocapAnything.git "{{ source }}"; \
    fi
    git -C "{{ source }}" cat-file -e "{{ revision }}^{commit}" 2>/dev/null \
        || git -C "{{ source }}" fetch --quiet origin "{{ revision }}"
    git -C "{{ source }}" checkout --quiet --detach "{{ revision }}"
    {{ gpu_shell }} uv sync --extra test

# Download the weights and the encoders (network only, no GPU)
download:
    {{ gpu_shell }} uv run --no-sync python -c "from mocapanything_model_server.server import download; download()"

# Report PyTorch, the CUDA device, Blender and whether the weights are downloaded
doctor:
    {{ gpu_shell }} uv run --no-sync python -m mocapanything_model_server.doctor

# Serve on 127.0.0.1:9122 (override with --port)
[positional-arguments]
serve *args:
    {{ gpu_shell }} uv run --no-sync mocapanything-model-server "$@"

# Unit tests (no GPU, no weights)
test:
    {{ gpu_shell }} uv run --no-sync pytest -q tests
