set shell := ["bash", "-euo", "pipefail", "-c"]

import "../common.just"

source := cache / "prompthmr-source"
revision := "3b566b7dbb28ce506c7ea972c18693f4c705ce8c"  # pragma: allowlist secret
export UV_PROJECT_ENVIRONMENT := cache / "venvs/prompthmr"

default:
    @just --justfile {{ justfile() }} --list

setup:
    if [[ ! -d "{{ source }}/.git" ]]; then git clone --filter=blob:none --no-checkout https://github.com/yufu-wang/PromptHMR.git "{{ source }}"; fi
    git -C "{{ source }}" checkout --quiet --detach "{{ revision }}"
    {{ gpu_shell }} uv sync --extra test
    cd worker && {{ gpu_shell }} env UV_PROJECT_ENVIRONMENT="{{ cache }}/venvs/prompthmr-worker" uv sync

download:
    {{ gpu_shell }} uv run --no-sync python -m prompthmr_model_server.download

doctor:
    {{ gpu_shell }} uv run --no-sync python -m prompthmr_model_server.doctor

[positional-arguments]
serve *args:
    {{ gpu_shell }} uv run --no-sync prompthmr-model-server "$@"

test:
    {{ gpu_shell }} uv run --no-sync pytest -q tests
