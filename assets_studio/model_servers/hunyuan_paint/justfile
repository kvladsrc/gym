set shell := ["bash", "-euo", "pipefail", "-c"]

# Heavy files live outside the Dropbox-synced working copy.
cache := env("XDG_CACHE_HOME", env("HOME") / ".cache") / "assets-studio"
source := cache / "hunyuan-paint-source"
revision := `sed -n 's/^SOURCE_REVISION = "\([0-9a-f]*\)".*/\1/p' src/hunyuan_paint_model_server/server.py`

export UV_PROJECT_ENVIRONMENT := cache / "venvs/hunyuan_paint"
export HUNYUAN_PAINT_SOURCE := source
export U2NET_HOME := cache / "u2net"
export HF_HUB_DISABLE_TELEMETRY := "1"
export HY3DGEN_MODELS := cache / "hy3dgen"

root := quote(justfile_directory() / "../../..")
gpu_shell := "nix develop " + root + "#assets-studio-gpu --command"
# With the CUDA toolkit: only to build the rasterizer.
cuda_shell := "nix develop " + root + "#assets-studio-cuda --command"

# Show the available commands
default:
    @just --justfile {{ justfile() }} --list

# Fetch the pinned Hunyuan3D-2 source, create the environment, build the CUDA rasterizer
setup:
    if [[ ! -d "{{ source }}/.git" ]]; then \
        git clone --no-checkout https://github.com/Tencent-Hunyuan/Hunyuan3D-2.git "{{ source }}"; \
    fi
    git -C "{{ source }}" cat-file -e "{{ revision }}^{commit}" 2>/dev/null \
        || git -C "{{ source }}" fetch --quiet origin "{{ revision }}"
    git -C "{{ source }}" checkout --quiet --detach "{{ revision }}"
    {{ gpu_shell }} uv sync --extra test
    # The laptop's RTX 3070 is sm_86: build for it only.
    {{ cuda_shell }} env TORCH_CUDA_ARCH_LIST=8.6 uv pip install --python "$UV_PROJECT_ENVIRONMENT" \
        --no-build-isolation "{{ source }}/hy3dgen/texgen/custom_rasterizer"

# Download the paint and delight weights (network only, no GPU)
download:
    {{ gpu_shell }} uv run --no-sync python -c "from hunyuan_paint_model_server.server import download; download()"

# Report PyTorch, the CUDA device, the rasterizer and whether the weights are downloaded
doctor:
    {{ gpu_shell }} uv run --no-sync python -m hunyuan_paint_model_server.doctor

# Serve on 127.0.0.1:9114 (override with --port); loads the model in the background
[positional-arguments]
serve *args:
    {{ gpu_shell }} uv run --no-sync hunyuan-paint-model-server "$@"

# Unit tests (no GPU, no weights)
test:
    {{ gpu_shell }} uv run --no-sync pytest -q tests
