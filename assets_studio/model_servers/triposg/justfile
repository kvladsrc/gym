set shell := ["bash", "-euo", "pipefail", "-c"]

# Heavy files live outside the Dropbox-synced working copy.
cache := env("XDG_CACHE_HOME", env("HOME") / ".cache") / "assets-studio"
source := cache / "triposg-source"
revision := `sed -n 's/^SOURCE_REVISION = "\([0-9a-f]*\)".*/\1/p' src/triposg_model_server/server.py`

export UV_PROJECT_ENVIRONMENT := cache / "venvs/triposg"
export TRIPOSG_SOURCE := source
export U2NET_HOME := cache / "u2net"
export HF_HUB_DISABLE_TELEMETRY := "1"

root := quote(justfile_directory() / "../../..")
gpu_shell := "nix develop " + root + "#assets-studio-gpu --command"
# With the CUDA toolkit: only to build diso.
cuda_shell := "nix develop " + root + "#assets-studio-cuda --command"

# Show the available commands
default:
    @just --justfile {{ justfile() }} --list

# Fetch the pinned TripoSG source, create the environment, build diso
setup:
    if [[ ! -d "{{ source }}/.git" ]]; then \
        git clone --no-checkout https://github.com/VAST-AI-Research/TripoSG.git "{{ source }}"; \
    fi
    git -C "{{ source }}" cat-file -e "{{ revision }}^{commit}" 2>/dev/null \
        || git -C "{{ source }}" fetch --quiet origin "{{ revision }}"
    git -C "{{ source }}" checkout --quiet --detach "{{ revision }}"
    {{ gpu_shell }} uv sync --extra test
    # The laptop's RTX 3070 is sm_86: build for it only.
    {{ cuda_shell }} env TORCH_CUDA_ARCH_LIST=8.6 MAX_JOBS=2 uv pip install --python "$UV_PROJECT_ENVIRONMENT" \
        --no-build-isolation diso==0.1.4

# Download the weights (~8 GB, network only, no GPU)
download:
    {{ gpu_shell }} uv run --no-sync python -c "from triposg_model_server.server import download; download()"

# Report PyTorch, the CUDA device, diso and whether the weights are downloaded
doctor:
    {{ gpu_shell }} uv run --no-sync python -m triposg_model_server.doctor

# Serve on 127.0.0.1:9115 (override with --port); loads the model in the background
[positional-arguments]
serve *args:
    {{ gpu_shell }} uv run --no-sync triposg-model-server "$@"

# Unit tests (no GPU, no weights)
test:
    {{ gpu_shell }} uv run --no-sync pytest -q tests
