set shell := ["bash", "-euo", "pipefail", "-c"]

import "../common.just"

export UV_PROJECT_ENVIRONMENT := cache / "venvs/unlimited_ocr"
export HF_HUB_DISABLE_TELEMETRY := "1"
export PYTORCH_CUDA_ALLOC_CONF := "expandable_segments:True"

default:
    @just --justfile {{ justfile() }} --list

# Install the isolated runtime and the pinned weights (~6.7 GB)
setup:
    {{ gpu_shell }} uv sync --extra test
    @just --justfile {{ justfile() }} download

download:
    {{ gpu_shell }} uv run --no-sync python -c "from unlimited_ocr_model_server.server import download; print(download())"

doctor:
    {{ gpu_shell }} uv run --no-sync python -m unlimited_ocr_model_server.doctor

[positional-arguments]
serve *args:
    {{ gpu_shell }} uv run --no-sync unlimited-ocr-model-server "$@"

# Contract, input validation and output handling; no weights or GPU
test:
    {{ gpu_shell }} uv run --no-sync pytest -q tests
