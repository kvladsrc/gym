set shell := ["bash", "-euo", "pipefail", "-c"]

import "../common.just"

export UV_PROJECT_ENVIRONMENT := cache / "venvs/htd_refine"

default:
    @just --justfile {{ justfile() }} --list

# Separate server and worker environments; reuse UV's downloaded package cache.
setup:
    {{ gpu_shell }} uv sync --extra test
    cd worker && {{ gpu_shell }} env UV_PROJECT_ENVIRONMENT="{{ cache }}/venvs/htd-refine-worker" uv sync

[positional-arguments]
serve *args:
    {{ gpu_shell }} uv run --no-sync htd-refine-model-server "$@"

test:
    {{ gpu_shell }} uv run --no-sync pytest -q tests

# Validate the pinned source, worker and cached/licensed model files without allocating GPU memory.
doctor:
    {{ gpu_shell }} uv run --no-sync python -c "from htd_refine_model_server.server import HTDRefineServer; s = HTDRefineServer(); s.load(); print('HTD-Refine source, worker and weights ready')"
