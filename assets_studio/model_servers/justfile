set shell := ["bash", "-euo", "pipefail", "-c"]

# Each GPU server is its own project with its own justfile and environment;
# these recipes only dispatch to them. `just <model>` starts the server,
# extra arguments go to it (e.g. `just qwen_image --port 9200`).

servers := "qwen_image flux3 birefnet pbrfusion4 sam2 sam3 hunyuan3d21 hi3d lato2 deepmesh bpt trellis2_paint hairdeck fromsoma hunyuan_paint21 mia skintokens unirig kimodo mocapanything gvhmr gemx htd_refine prompthmr vitpose animation_tools audio2face chatterbox qwen3_tts stable_audio yue2 llm unlimited_ocr qwen_review"

# Show the available commands
default:
    @just --justfile {{ source_file() }} --list

# Qwen-Image 2.1 Q8: images, transparency, editing (port 9109)
[positional-arguments]
qwen_image *args:
    just --justfile qwen_image/justfile serve "$@"

alias qwen-image := qwen_image

