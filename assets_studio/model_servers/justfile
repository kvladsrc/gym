set shell := ["bash", "-euo", "pipefail", "-c"]

# Each GPU server is its own project with its own justfile and environment;
# these recipes only dispatch to them. `just <model>` starts the server,
# extra arguments go to it (e.g. `just flux --port 9200`).

servers := "flux qwen_image hunyuan3d hunyuan_paint mia xtts stable_audio yue2 llm wan"

# Show the available commands
default:
    @just --justfile {{ source_file() }} --list

# FLUX.1-schnell Q8: images (port 9104; needs HF_TOKEN)
[positional-arguments]
flux *args:
    just --justfile flux/justfile serve "$@"

# Qwen-Image 2.1 Q8: images, transparency, editing (port 9109)
[positional-arguments]
qwen_image *args:
    just --justfile qwen_image/justfile serve "$@"

alias qwen-image := qwen_image

# Hunyuan3D-2mini: image to 3D shape (port 9112)
[positional-arguments]
hunyuan3d *args:
    just --justfile hunyuan3d/justfile serve "$@"

# Hunyuan3D-Paint v2.0 turbo: paint a mesh from its image (port 9114)
[positional-arguments]
hunyuan_paint *args:
    just --justfile hunyuan_paint/justfile serve "$@"

alias hunyuan-paint := hunyuan_paint

# Make-It-Animatable v2: a Mixamo skeleton for a character mesh (port 9113; needs HF_TOKEN)
[positional-arguments]
mia *args:
    just --justfile mia/justfile serve "$@"

# XTTS-v2: speech (port 9103)
[positional-arguments]
xtts *args:
    just --justfile xtts/justfile serve "$@"

# Stable Audio Open 1.0: sounds and music (port 9105; needs HF_TOKEN)
[positional-arguments]
stable_audio *args:
    just --justfile stable_audio/justfile serve "$@"

alias stable-audio := stable_audio

# YuE2 3B: songs with vocals from lyrics and a style (port 9110)
[positional-arguments]
yue2 *args:
    just --justfile yue2/justfile serve "$@"

# Gemma 4 12B: text, Russian included (port 9106)
[positional-arguments]
gemma *args:
    just --justfile llm/justfile serve --model gemma-4-12b "$@"

# Qwen3.8 27B: text, more inventive, slower (port 9107)
[positional-arguments]
qwen *args:
    just --justfile llm/justfile serve --model qwen3.8-27b --port 9107 "$@"

# Wan2.2 TI2V-5B: video from a first frame (port 9108)
[positional-arguments]
wan *args:
    just --justfile wan/justfile serve "$@"

# GPU-free fake server for tests (port 9100)
[positional-arguments]
fake *args:
    cd .. && uv run fake-model-server "$@"

# Create the environment of one server, or of all of them
setup model="all":
    @just --justfile {{ source_file() }} _each setup {{ model }}

# Report device and downloaded weights of one server, or of all of them
doctor model="all":
    @just --justfile {{ source_file() }} _each doctor {{ model }}

# Unit tests (no GPU) of one server, or of all of them
test model="all":
    @just --justfile {{ source_file() }} _each test {{ model }}

[private]
_each recipe model:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ "{{ model }}" = all ]; then models="{{ servers }}"; else models="{{ model }}"; fi
    for model in $models; do
        if [ ! -f "$model/justfile" ]; then
            echo "unknown model server: $model (one of: {{ servers }})" >&2
            exit 1
        fi
        echo "== $model"
        just --justfile "$model/justfile" {{ recipe }}
    done
