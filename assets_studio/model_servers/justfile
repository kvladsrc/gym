set shell := ["bash", "-euo", "pipefail", "-c"]

# Each GPU server is its own project with its own justfile and environment;
# these recipes only dispatch to them. `just <model>` starts the server,
# extra arguments go to it (e.g. `just qwen_image --port 9200`).

servers := "qwen_image birefnet sam2 hunyuan3d21 hi3d hunyuan_paint21 mia skintokens unirig kimodo mocapanything gvhmr gemx htd_refine prompthmr animation_tools xtts stable_audio yue2 llm wan"

# Show the available commands
default:
    @just --justfile {{ source_file() }} --list

# Qwen-Image 2.1 Q8: images, transparency, editing (port 9109)
[positional-arguments]
qwen_image *args:
    just --justfile qwen_image/justfile serve "$@"

alias qwen-image := qwen_image

# BiRefNet: background removal, image to image (port 9121)
[positional-arguments]
birefnet *args:
    just --justfile birefnet/justfile serve "$@"

# Hunyuan3D-2.1 Shape: image to 3D shape, the 3.3B model offloaded to RAM (port 9119)
[positional-arguments]
hunyuan3d21 *args:
    just --justfile hunyuan3d21/justfile serve "$@"

# Hi3D v1.0: a coarse mesh refined from its image, up to a 1536³ grid (port 9130)
[positional-arguments]
hi3d *args:
    just --justfile hi3d/justfile serve "$@"

# Hunyuan3D-Paint 2.1: PBR paint of a mesh from its image, offloaded to RAM (port 9120)
[positional-arguments]
hunyuan_paint21 *args:
    just --justfile hunyuan_paint21/justfile serve "$@"

# Make-It-Animatable v2: a Mixamo skeleton for a character mesh (port 9113; needs HF_TOKEN)
[positional-arguments]
mia *args:
    just --justfile mia/justfile serve "$@"

# SkinTokens: a skeleton of any shape and skin weights (port 9116)
[positional-arguments]
skintokens *args:
    just --justfile skintokens/justfile serve "$@"

# UniRig: a skeleton of any shape and skin weights (port 9117)
[positional-arguments]
unirig *args:
    just --justfile unirig/justfile serve "$@"

# Kimodo: humanoid animation from a description (port 9118; Llama 3 access on HF_TOKEN)
[positional-arguments]
kimodo *args:
    just --justfile kimodo/justfile serve "$@"

# Kimodo on the SMPL-X body: native motion and in-betweens of native clips (port 9128)
[positional-arguments]
kimodo_smplx *args:
    just --justfile kimodo/justfile serve --model smplx --port 9128 "$@"

# MoCapAnything V2: a quadruped rig animated from a video (port 9122)
[positional-arguments]
mocapanything *args:
    just --justfile mocapanything/justfile serve "$@"

# GVHMR: human motion capture from video (port 9123)
[positional-arguments]
gvhmr *args:
    just --justfile gvhmr/justfile serve "$@"

# GEM-X: whole-body motion capture from video as SOMA (port 9129)
[positional-arguments]
gemx *args:
    just --justfile gemx/justfile serve "$@"

# HTD-Refine: refine raw native motion before joining/retargeting (port 9127)
[positional-arguments]
htd_refine *args:
    just --justfile htd_refine/justfile serve "$@"

# Prepare rigs and transfer humanoid animation, Blender without neural weights (port 9124)
[positional-arguments]
animation_tools *args:
    just --justfile animation_tools/justfile serve "$@"

# Track one selected subject, preserve original pixels, white background (port 9125)
[positional-arguments]
sam2 *args:
    just --justfile sam2/justfile serve "$@"

# XTTS-v2: speech (port 9103)
[positional-arguments]
xtts *args:
    just --justfile xtts/justfile serve "$@"

# Stable Audio Open 1.0: sounds and music (port 9105; needs HF_TOKEN)
[positional-arguments]
stable_audio *args:
    just --justfile stable_audio/justfile serve "$@"

alias stable-audio := stable_audio

# YuE2 3B: songs with vocals from lyrics and a style (port 9110)
