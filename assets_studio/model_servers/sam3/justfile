set shell := ["bash", "-euo", "pipefail", "-c"]

import "../common.just"

export UV_PROJECT_ENVIRONMENT := cache / "venvs/sam3"
export HF_HUB_DISABLE_TELEMETRY := "1"
# The SAM 3.1 checkpoint is in a gated repository (accept Meta's licence first).
export HF_TOKEN := env("HF_TOKEN", env("HUGGINGFACE_TOKEN", ""))

# Show the available commands
default:
    @just --justfile {{ justfile() }} --list

# Create the Python environment
setup:
    {{ gpu_shell }} uv sync --extra test

# Download the checkpoint (~3.5 GB; network only, needs HF_TOKEN)
download:
    {{ gpu_shell }} uv run --no-sync python -m sam3_model_server.doctor --download

# Report PyTorch, the CUDA device, ffmpeg and the checkpoint
doctor:
    {{ gpu_shell }} uv run --no-sync python -m sam3_model_server.doctor

# Serve on 127.0.0.1:9148 (override with --port); loads the model in the background
[positional-arguments]
serve *args:
    {{ gpu_shell }} uv run --no-sync sam3-model-server "$@"

# Unit tests (no GPU, no weights)
test:
    {{ gpu_shell }} uv run --no-sync pytest -q tests
