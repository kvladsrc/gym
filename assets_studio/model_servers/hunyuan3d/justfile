set shell := ["bash", "-euo", "pipefail", "-c"]

# Heavy files live outside the Dropbox-synced working copy.
cache := env("XDG_CACHE_HOME", env("HOME") / ".cache") / "assets-studio"
source := cache / "hunyuan3d-source"
revision := `sed -n 's/^SOURCE_REVISION = "\([0-9a-f]*\)".*/\1/p' src/hunyuan3d_model_server/server.py`

export UV_PROJECT_ENVIRONMENT := cache / "venvs/hunyuan3d"
export HUNYUAN3D_SOURCE := source
export U2NET_HOME := cache / "u2net"
export HF_HUB_DISABLE_TELEMETRY := "1"

gpu_shell := "nix develop " + quote(justfile_directory() / "../../..") + "#assets-studio-gpu --command"

# Show the available commands
default:
    @just --justfile {{ justfile() }} --list

# Fetch the pinned Hunyuan3D-2 source and create the environment
setup:
    if [[ ! -d "{{ source }}/.git" ]]; then \
        git clone --no-checkout https://github.com/Tencent-Hunyuan/Hunyuan3D-2.git "{{ source }}"; \
    fi
    git -C "{{ source }}" cat-file -e "{{ revision }}^{commit}" 2>/dev/null \
        || git -C "{{ source }}" fetch --quiet origin "{{ revision }}"
    git -C "{{ source }}" checkout --quiet --detach "{{ revision }}"
    {{ gpu_shell }} uv sync --extra test

# Report PyTorch, the CUDA device and whether the weights are downloaded
doctor:
    {{ gpu_shell }} uv run --no-sync python -m hunyuan3d_model_server.doctor

# Serve on 127.0.0.1:9112 (override with --port); loads the model in the background
[positional-arguments]
serve *args:
    {{ gpu_shell }} uv run --no-sync hunyuan3d-model-server "$@"

# Unit tests (no GPU, no weights)
test:
    {{ gpu_shell }} uv run --no-sync pytest -q tests
