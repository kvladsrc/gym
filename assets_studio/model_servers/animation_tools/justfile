set shell := ["bash", "-euo", "pipefail", "-c"]

import "../common.just"

export UV_PROJECT_ENVIRONMENT := cache / "venvs/animation_tools"

default:
    @just --justfile {{ justfile() }} --list

# Lightweight Python environment; Blender is the processing backend, no weights
setup:
    {{ gpu_shell }} uv sync --extra test

# Prepare rigs and retarget animation (port 9124)
[positional-arguments]
serve *args:
    {{ gpu_shell }} uv run --no-sync animation-tools-model-server "$@"

# Report the Blender executable
doctor:
    {{ gpu_shell }} uv run --no-sync python -c "from animation_tools_model_server.server import blender; print(blender() or 'Blender not found')"

# Contract and error-handling tests, without Blender or GPU
test:
    {{ gpu_shell }} uv run --no-sync pytest -q tests

# Real Blender regressions: different bind poses, terminal wrist twist and root travel
integration:
    {{ gpu_shell }} env RUN_BLENDER_TESTS=1 uv run --no-sync pytest -q tests/test_blender_integration.py
