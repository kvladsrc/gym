set shell := ["bash", "-euo", "pipefail", "-c"]

import "../common.just"

export UV_PROJECT_ENVIRONMENT := cache / "venvs/qwen3_tts"
export HF_HUB_DISABLE_TELEMETRY := "1"

# Show the available commands
default:
    @just --justfile {{ justfile() }} --list

# Create the Python environment (each model's weights download on its first start, ~4.5 GB)
setup:
    {{ gpu_shell }} uv sync --extra test

# Download the weights of one model or all (design, voice, clone; network only, no GPU)
download model="all":
    {{ gpu_shell }} uv run --no-sync python -m qwen3_tts_model_server.doctor --download {{ quote(model) }}

# Report PyTorch, the CUDA device and which models are downloaded
doctor:
    {{ gpu_shell }} uv run --no-sync python -m qwen3_tts_model_server.doctor

# Serve one model on 127.0.0.1:9139 (--model design | voice | clone; --port to override)
[positional-arguments]
serve *args:
    {{ gpu_shell }} uv run --no-sync qwen3-tts-model-server "$@"

# Unit tests (no GPU, no weights)
test:
    {{ gpu_shell }} uv run --no-sync pytest -q tests
