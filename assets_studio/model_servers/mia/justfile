set shell := ["bash", "-euo", "pipefail", "-c"]

# Heavy files live outside the Dropbox-synced working copy.
cache := env("XDG_CACHE_HOME", env("HOME") / ".cache") / "assets-studio"
source := cache / "mia-source"
revision := `sed -n 's/^SOURCE_REVISION = "\([0-9a-f]*\)".*/\1/p' src/mia_model_server/server.py`

export UV_PROJECT_ENVIRONMENT := cache / "venvs/mia"
export MIA_SOURCE := source
export HF_HUB_DISABLE_TELEMETRY := "1"
# The Hunyuan3D-2.1 VAE (the backbone) is looked up here before the Hub.
export HY3DGEN_MODELS := cache / "hy3dgen"
# The Mixamo skeleton template is in a gated dataset (automatic approval).
export HF_TOKEN := env("HF_TOKEN", env("HUGGINGFACE_TOKEN", ""))

gpu_shell := "nix develop " + quote(justfile_directory() / "../../..") + "#assets-studio-gpu --command"

# Show the available commands
default:
    @just --justfile {{ justfile() }} --list

# Fetch the pinned Make-It-Animatable v2 source (with the Hunyuan3D-2.1 submodule) and create the environment
setup:
    if [[ ! -d "{{ source }}/.git" ]]; then \
        git clone --no-checkout https://github.com/jasongzy/Make-It-Animatable.git "{{ source }}"; \
    fi
    git -C "{{ source }}" cat-file -e "{{ revision }}^{commit}" 2>/dev/null \
        || git -C "{{ source }}" fetch --quiet origin "{{ revision }}"
    git -C "{{ source }}" checkout --quiet --detach "{{ revision }}"
    git -C "{{ source }}" submodule update --init --depth 1 util/Hunyuan3D_21
    {{ gpu_shell }} uv sync --extra test

# Download the weights, the skeleton template and the VAE (network only, no GPU)
download:
    {{ gpu_shell }} uv run --no-sync python -c "from mia_model_server.server import download; download()"

# Report PyTorch, the CUDA device, bpy and whether the weights are downloaded
doctor:
    {{ gpu_shell }} uv run --no-sync python -m mia_model_server.doctor

# Serve on 127.0.0.1:9113 (override with --port); loads the model in the background
[positional-arguments]
serve *args:
    {{ gpu_shell }} uv run --no-sync mia-model-server "$@"

# Unit tests (no GPU, no weights)
test:
    {{ gpu_shell }} uv run --no-sync pytest -q tests
