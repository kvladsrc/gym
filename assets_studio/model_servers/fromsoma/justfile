set shell := ["bash", "-euo", "pipefail", "-c"]

import "../common.just"

export UV_PROJECT_ENVIRONMENT := cache / "venvs/fromsoma"
export FROMSOMA_ROOT := cache / "fromsoma"
export HF_HUB_DISABLE_TELEMETRY := "1"

# Show the available commands
default:
    @just --justfile {{ justfile() }} --list

# Create the environment (CPU PyTorch)
setup:
    {{ gpu_shell }} uv sync --extra test

# Download SOMA-X's data and MediaPipe's Face Landmarker (~120 MB; model.pt, frommhr.pt and fromanny.pt come from the readers' training)
download:
    {{ gpu_shell }} uv run --no-sync python -c "from fromsoma_model_server.server import download; download()"

# Report PyTorch and whether model.pt, SOMA-X's data and the landmarker are in place
doctor:
    {{ gpu_shell }} uv run --no-sync python -m fromsoma_model_server.doctor

# Serve on 127.0.0.1:9142 (override with --port); loads the model in the background
[positional-arguments]
serve *args:
    {{ gpu_shell }} uv run --no-sync fromsoma-model-server "$@"

# Serve frommhr (MHR's face space) on 127.0.0.1:9143 (override with --port); shares the root and environment
[positional-arguments]
serve-mhr *args:
    {{ gpu_shell }} uv run --no-sync python -m fromsoma_model_server.frommhr "$@"

# Serve fromanny (Anny's own face modifiers) on 127.0.0.1:9144 (override with --port); shares the root and environment
[positional-arguments]
serve-anny *args:
    {{ gpu_shell }} uv run --no-sync python -m fromsoma_model_server.fromanny "$@"

# Unit tests (no weights or data needed)
test:
    {{ gpu_shell }} uv run --no-sync pytest -q tests
