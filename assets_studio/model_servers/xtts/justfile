set shell := ["bash", "-euo", "pipefail", "-c"]

import "../common.just"

export UV_PROJECT_ENVIRONMENT := cache / "venvs/xtts"
export HF_HUB_DISABLE_TELEMETRY := "1"

# Show the available commands
default:
    @just --justfile {{ justfile() }} --list

# Create the Python environment (weights download on first start, ~2 GB)
setup:
    {{ gpu_shell }} uv sync --extra test

# Report PyTorch, the CUDA device and whether the weights are downloaded
doctor:
    {{ gpu_shell }} uv run python -m xtts_model_server.doctor

# Serve on 127.0.0.1:9103 (override with --port); loads the model in the background
[positional-arguments]
serve *args:
    {{ gpu_shell }} uv run xtts-model-server "$@"

# Unit tests (no GPU, no weights)
test:
    {{ gpu_shell }} uv run pytest -q tests
