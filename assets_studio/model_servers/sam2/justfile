set shell := ["bash", "-euo", "pipefail", "-c"]

import "../common.just"

export UV_PROJECT_ENVIRONMENT := cache / "venvs/sam2"

default:
    @just --justfile {{ justfile() }} --list

setup:
    {{ gpu_shell }} uv sync --extra test

[positional-arguments]
serve *args:
    {{ gpu_shell }} uv run --no-sync sam2-model-server "$@"

doctor:
    {{ gpu_shell }} uv run --no-sync python -m sam2_model_server.doctor

test:
    {{ gpu_shell }} uv run --no-sync pytest -q tests
