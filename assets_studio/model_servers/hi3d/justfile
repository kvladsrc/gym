set shell := ["bash", "-euo", "pipefail", "-c"]

# Heavy files live outside the Dropbox-synced working copy.
cache := env("XDG_CACHE_HOME", env("HOME") / ".cache") / "assets-studio"
source := cache / "hi3d-source"
revision := `sed -n 's/^SOURCE_REVISION = "\([0-9a-f]*\)".*/\1/p' src/hi3d_model_server/server.py`

export UV_PROJECT_ENVIRONMENT := cache / "venvs/hi3d"
export HI3D_SOURCE := source
export HI3D_WEIGHTS := cache / "hi3d"
export U2NET_HOME := cache / "u2net"
export HF_HUB_DISABLE_TELEMETRY := "1"
# A 1024³ pass peaks within a few hundred MB of 8 GB: no fragmentation.
export PYTORCH_CUDA_ALLOC_CONF := "expandable_segments:True"

gpu_shell := "nix develop " + quote(justfile_directory() / "../../..") + "#assets-studio-gpu --command"

# Show the available commands
default:
    @just --justfile {{ justfile() }} --list

# Fetch the pinned Hi3D source and create the environment
setup:
    if [[ ! -d "{{ source }}/.git" ]]; then \
        git clone --no-checkout https://github.com/hi3d-official/Hi3Dv1.0.git "{{ source }}"; \
    fi
    git -C "{{ source }}" cat-file -e "{{ revision }}^{commit}" 2>/dev/null \
        || git -C "{{ source }}" fetch --quiet origin "{{ revision }}"
    git -C "{{ source }}" checkout --quiet --detach "{{ revision }}"
    {{ gpu_shell }} uv sync --extra test

# Download the pipeline artifact (~7.7 GB; network only, no GPU)
download:
    {{ gpu_shell }} uv run --no-sync python -c "from hi3d_model_server.server import download; download()"

# Report PyTorch, the CUDA device, the kernels and whether the weights are downloaded
doctor:
    {{ gpu_shell }} uv run --no-sync python -m hi3d_model_server.doctor

# Serve on 127.0.0.1:9130 (override with --port); loads the model in the background
[positional-arguments]
serve *args:
    {{ gpu_shell }} uv run --no-sync hi3d-model-server "$@"

# Unit tests (no GPU, no weights)
test:
    {{ gpu_shell }} uv run --no-sync pytest -q tests
