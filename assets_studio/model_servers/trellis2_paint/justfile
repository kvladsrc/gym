set shell := ["bash", "-euo", "pipefail", "-c"]

import "../common.just"

export UV_PROJECT_ENVIRONMENT := cache / "venvs/trellis2_paint"
export TRELLIS2_SOURCE := cache / "trellis2-source"
export TRELLIS2_PAINT_WEIGHTS := cache / "trellis2-paint"
export HF_HUB_DISABLE_TELEMETRY := "1"
export HF_HUB_DISABLE_XET := "1"
export ATTN_BACKEND := "xformers"
export SPARSE_ATTN_BACKEND := "xformers"
export PYTORCH_CUDA_ALLOC_CONF := "expandable_segments:True"

default:
    @just --justfile {{ justfile() }} --list

# Separate environment; reuse cached native wheels, build them only if absent.
setup:
    {{ gpu_shell }} uv sync --extra test
    {{ cuda_shell }} env TORCH_CUDA_ARCH_LIST={{ quote(cuda_arch) }} MAX_JOBS={{ quote(build_jobs) }} uv run --no-sync python -m trellis2_paint_model_server.setup_native

# Download only the 512 texture transformer, encoder, decoder and DINOv3 (~5.5 GB).
download:
    {{ gpu_shell }} uv run --no-sync python -c "from trellis2_paint_model_server.server import download; download()"

[positional-arguments]
serve *args:
    {{ gpu_shell }} uv run --no-sync trellis2-paint-model-server "$@"

test:
    {{ gpu_shell }} uv run --no-sync pytest -q tests
