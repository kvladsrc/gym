set shell := ["bash", "-euo", "pipefail", "-c"]

default:
    @just --justfile justfile --list

cli *args:
    bash tools/run.sh cli {{ args }}

editor:
    @echo "Open $(pwd)/unity in Unity Hub. This recipe does not launch another Editor."

# Rebuild local art in a separate headless Blender process.
assets:
    {{ env("HOME") }}/.nix-profile/bin/blender --background --python-exit-code 1 --python tools/create_assets.py

# Rebuild art through the running Blender MCP connection.
assets-mcp:
    python3 tools/mcp_call.py execute_blender_code "$(python3 -c 'import json,pathlib; print(json.dumps({"code": "import runpy; runpy.run_path(" + repr(str(pathlib.Path("tools/create_assets.py").resolve())) + ", run_name=" + repr("__main__") + ")", "user_prompt": "Create Mosslight level and character in a dedicated scene, export local FBX assets."}))')"

prepare:
    bash tools/run.sh cli command eval 'Mosslight.Editor.ProjectSetup.Create(); return "prepared";' --project-path "$(pwd)/unity" --timeout 120 --format json

build:
    python3 tools/build.py

play:
    {{ env("HOME") }}/.nix-profile/bin/nixGLMesa artifacts/build/Mosslight.x86_64 -screen-width 1280 -screen-height 800 -screen-fullscreen 0

# Standard-library checks only; suitable for the existing build node.
check:
    python3 tools/check.py
    shellcheck tools/run.sh

status:
    bash tools/run.sh cli status --project-path "$(pwd)/unity" --format json

mcp-config *args:
    python3 tools/configure_mcp.py {{ args }}

# Run the real Player with graphics, walk to a crystal, and save a screenshot.
smoke:
    timeout 60 {{ env("HOME") }}/.nix-profile/bin/nixGLMesa artifacts/build/Mosslight.x86_64 -screen-width 1280 -screen-height 800 -screen-fullscreen 0 -logFile "$(pwd)/artifacts/player-smoke.log" --smoke --capture="$(pwd)/artifacts/smoke.png"
    rg 'MOSSLIGHT_SMOKE .*"passed":true' artifacts/player-smoke.log
