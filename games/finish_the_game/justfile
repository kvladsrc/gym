set shell := ["bash", "-euo", "pipefail", "-c"]

# The Unity project; the Editor must be open on it (Unity Hub) for all but `run`.
project := source_directory() / "unity/Finish the game"
unity := "unity cmd --no-banner --project-path '" + project + "'"
# The same, printing nothing but errors.
quiet := "unity cmd --no-banner --quiet --project-path '" + project + "'"
player := project / "Builds/Linux/FinishTheGame.x86_64"

# Show all available commands
default:
    @just --list --list-submodules

# Make the scenes anew: Crystal (the crystal in the liquid), Plane (the band and the horizon), Loop (the bent ribbon)
scene:
    @{{ quiet }} menu --path "Finish the Game/Build Loop Scene"
    @{{ quiet }} menu --path "Finish the Game/Build Plane Scene"
    @{{ quiet }} menu --path "Finish the Game/Build Crystal Scene"

# Play a scene in the Editor: Crystal, Plane or Loop
play name="Crystal":
    @{{ quiet }} editor_stop
    @{{ quiet }} open_scene --path Assets/FinishTheGame/Scenes/{{ name }}.unity
    @{{ quiet }} editor_play

# Leave play mode
stop:
    @{{ quiet }} editor_stop

# Save the game view to screenshots/<name>.png (in play mode)
shot name="shot":
    mkdir -p screenshots
    {{ unity }} eval 'UnityEngine.ScreenCapture.CaptureScreenshot("{{ source_directory() }}/screenshots/{{ name }}.png"); return "ok";'
    for _ in $(seq 20); do [[ -f screenshots/{{ name }}.png ]] && break; sleep 0.5; done
    ls screenshots/{{ name }}.png

# Build the Linux player (the Editor answers at once; its log tells the end)
build:
    #!/usr/bin/env bash
    set -euo pipefail
    log='{{ project }}/Logs/Editor.log'
    from=$(wc -l <"$log")
    {{ unity }} eval 'var r = UnityEditor.BuildPipeline.BuildPlayer(new UnityEditor.BuildPlayerOptions { scenes = new[] { "Assets/FinishTheGame/Scenes/Crystal.unity", "Assets/FinishTheGame/Scenes/Plane.unity", "Assets/FinishTheGame/Scenes/Loop.unity" }, locationPathName = "{{ player }}", target = UnityEditor.BuildTarget.StandaloneLinux64 }); UnityEngine.Debug.Log("FinishTheGame: player " + r.summary.result + ", " + (r.summary.totalSize / 1048576) + " MB"); return "";' >/dev/null 2>&1 || true
    for _ in $(seq 360); do
        if line=$(tail -n +"$from" "$log" | grep -m1 "^FinishTheGame: player"); then
            echo "$line"
            [[ $line == *Succeeded* ]]
            exit
        fi
        sleep 5
    done
    echo "timed out waiting for the build" >&2
    exit 1

# Run the Linux build on the NVIDIA GPU (PRIME offload)
run:
    __NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia __VK_LAYER_NV_optimus=NVIDIA_only '{{ player }}'
