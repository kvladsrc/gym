set shell := ["bash", "-euo", "pipefail", "-c"]
godot := env("GODOT", if path_exists(env("HOME") / ".nix-profile/bin/godot") == "true" { env("HOME") / ".nix-profile/bin/godot" } else { "godot" })

default:
    @just --justfile justfile --list

# Run the offline game
run:
    {{ quote(godot) }} --path . --fullscreen

# Open the Godot editor
editor:
    {{ quote(godot) }} --editor --path .

fmt:
    gdformat scripts tools/*.gd

lint:
    gdlint scripts tools/*.gd

# Recreate the original offline soundtrack from its score/synth source
music:
    godot --headless --path . --script tools/compose_music.gd

# Import, verify rules and exercise UI transitions without a display
check: lint
    bash tools/check.sh

# Check only this project's files with the shared repository hooks
repo-lint:
    cd ../.. && rg --files --hidden games/vibe_jakubovich_mvp -0 | xargs -0 pre-commit run --files

# Export a Linux executable and sidecar PCK using the pinned template
build:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p build
    template=$(command -v godot-template)
    godot --headless --path . --import --quit
    godot --headless --path . --export-pack Linux build/game.pck
    cp "${template}" build/pole-chudes.x86_64
    chmod u+w,u+x build/pole-chudes.x86_64
    mv build/game.pck build/pole-chudes.pck

# Run the exported pack through the selected graphics-compatible Godot
play-build:
    {{ quote(godot) }} --main-pack build/pole-chudes.pck --fullscreen

# Brief graphics/audio startup check of the exported pack with clean shutdown
smoke:
    {{ quote(godot) }} --main-pack build/pole-chudes.pck --fullscreen -- --smoke

# Capture a real rendered frame; requires a working desktop GPU
capture:
    mkdir -p tmp
    {{ quote(godot) }} --path . --fullscreen -- --capture

# Small looping GIF recorded from the game itself; requires desktop GPU + FFmpeg
gif:
    mkdir -p assets/previews
    {{ quote(godot) }} --path . --fixed-fps 20 --script tools/record_gif.gd
    ffmpeg -hide_banner -loglevel error -y -framerate 20 -i tmp/wheel-gif/frame%03d.png -frames:v 66 -filter_complex "fps=15,scale=640:-1:flags=lanczos,split[a][b];[a]palettegen=max_colors=128:stats_mode=diff[p];[b][p]paletteuse=dither=bayer:bayer_scale=4:diff_mode=rectangle" -loop 0 assets/previews/wheel.gif
