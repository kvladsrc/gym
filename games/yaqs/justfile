set shell := ["bash", "-euo", "pipefail", "-c"]
set working-directory := "../.."
cache := env("XDG_CACHE_HOME", env("HOME") / ".cache") / "yaqs"
export UV_PROJECT_ENVIRONMENT := cache / "venv"
export HF_HUB_DISABLE_TELEMETRY := "1"
export TOKENIZERS_PARALLELISM := "false"
project := quote(source_directory())

default:
    @just --justfile {{ source_file() }} --list

# Runtime outside Dropbox; reuse the pinned Qwen checkpoint in the HF cache
setup:
    uv sync --project {{ project }} --locked --extra dev
    uv run --project {{ project }} --no-sync yaqs download

# Import text, wait for other importers and resume completed embeddings
[positional-arguments]
import path *args:
    uv run --project {{ project }} --no-sync yaqs import --wait-for-lock "$@"

# Search defaults to CPU so it can run while Studio owns the GPU
[positional-arguments]
search query *args:
    uv run --project {{ project }} --no-sync yaqs search "$@"

[positional-arguments]
run *args:
    uv run --project {{ project }} --no-sync yaqs "$@"

[positional-arguments]
stats *args:
    uv run --project {{ project }} --no-sync yaqs stats "$@"

# Offline checks for runtime, cached model and database readiness
[positional-arguments]
doctor *args:
    uv run --project {{ project }} --no-sync yaqs doctor "$@"

[positional-arguments]
books *args:
    uv run --project {{ project }} --no-sync yaqs books "$@"

# Check the actual data and both search indexes
[positional-arguments]
check-db *args:
    uv run --project {{ project }} --no-sync yaqs check "$@"

[positional-arguments]
page book number *args:
    uv run --project {{ project }} --no-sync yaqs page "$@"

[positional-arguments]
passage chunk *args:
    uv run --project {{ project }} --no-sync yaqs passage "$@"

# Consistent SQLite snapshot, including committed WAL data
[positional-arguments]
backup path *args:
    uv run --project {{ project }} --no-sync yaqs backup "$@"

# Remove the indexed book; original source files remain in their source directory
[positional-arguments]
remove book *args:
    uv run --project {{ project }} --no-sync yaqs remove "$@"

# Recreate a complete database from stored page text without running OCR
[positional-arguments]
rebuild output *args:
    uv run --project {{ project }} --no-sync yaqs rebuild --output "$@"

# Shared local MCP endpoint at http://127.0.0.1:9033/mcp
[positional-arguments]
serve *args:
    uv run --project {{ project }} --no-sync yaqs serve "$@"

fmt:
    uv run --project {{ project }} --no-sync ruff check --fix {{ project }}
    uv run --project {{ project }} --no-sync ruff format {{ project }}

test:
    uv run --project {{ project }} --no-sync pytest -q {{ project }}/tests

check:
    uv run --project {{ project }} --no-sync ruff check {{ project }}
    uv run --project {{ project }} --no-sync ruff format --check {{ project }}
    uv run --project {{ project }} --no-sync pytest -q {{ project }}/tests
