# Unity: generated by the Editor
/unity/realms/Library/
/unity/realms/Temp/
/unity/realms/Obj/
/unity/realms/Logs/
/unity/realms/Builds/
/unity/realms/UserSettings/*
# Keep the Search runaway mitigation in fresh checkouts.
!/unity/realms/UserSettings/Search.settings
/unity/realms/.vs/
/unity/realms/*.csproj
/unity/realms/*.sln*

# Studio art (tools/fetch_art.py) and the prefabs, materials and scene Realms/Setup makes.
# Art's children, not Art itself: the public copy (scripts/sync_gym.sh) takes the Studio art
# back in, which Git allows only under a folder that is not ignored as a whole.
/unity/realms/Assets/Realms/Art/*
/unity/realms/Assets/Realms/Art.meta
/unity/realms/Assets/Realms/Generated/
/unity/realms/Assets/Realms/Generated.meta

# dotnet builds of the game core (tools/core)
/tools/core/*/bin/
/tools/core/*/obj/

# The public copy carries these (scripts/sync_gym.sh).
!/unity/realms/Assets/Realms/Art.meta
!/unity/realms/Assets/Realms/Art/Icons*
!/unity/realms/Assets/Realms/Art/Models*
!/unity/realms/Assets/Realms/Art/Textures*
!/unity/realms/Assets/Realms/Art/manifest.json*
!/unity/realms/UserSettings/Search.settings
