    {
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "id": 8,
      "options": {
        "dedupStrategy": "none",
        "enableInfiniteScrolling": true,
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "_msg:~\"(?i)\\b(error|fatal|panic|exception|failed|oomkilled)\\b\"",
          "maxLines": 50,
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Problems in logs (empty is healthy)",
