          "editorMode": "code",
          "expr": "topk(10, 100 * max by (k8s_namespace_name, k8s_pod_name, k8s_container_name) (container_memory_working_set_bytes{k8s_cluster_name=\"your.domain\"}) / on (k8s_namespace_name, k8s_pod_name, k8s_container_name) group_left max by (k8s_namespace_name, k8s_pod_name, k8s_container_name) (k8s_container_memory_request_bytes{k8s_cluster_name=\"your.domain\"}))",
          "legendFormat": "{{k8s_namespace_name}}/{{k8s_pod_name}}:{{k8s_container_name}}",
          "range": true,
          "refId": "A"
        }
