      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(clamp_min(delta(k8s_container_restarts{k8s_cluster_name=\"your.domain\"}[$__range]), 0)) or vector(0)",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Restarts in time range",
      "type": "stat"
