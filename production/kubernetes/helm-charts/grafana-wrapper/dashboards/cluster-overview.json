        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(kube_pod_container_status_last_terminated_reason{k8s_cluster_name=\"your.domain\",reason=\"OOMKilled\"} == 1) or vector(0)",
