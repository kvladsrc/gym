      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "(sum(kube_deployment_status_replicas_unavailable{k8s_cluster_name=\"your.domain\"}) or vector(0)) + (sum(kube_statefulset_status_replicas{k8s_cluster_name=\"your.domain\"} - kube_statefulset_status_replicas_ready{k8s_cluster_name=\"your.domain\"}) or vector(0)) + (sum(kube_daemonset_status_number_unavailable{k8s_cluster_name=\"your.domain\"}) or vector(0))",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Unavailable replicas",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "thresholds": {
