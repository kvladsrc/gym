#!/usr/bin/env bash
set -euo pipefail

tool_namespace="${OBSERVABILITY_TOOL_NAMESPACE:-observability}"
tool_target="${OBSERVABILITY_TOOL_TARGET:-statefulset/victoria-metrics}"
remote_wget="${OBSERVABILITY_WGET:-/usr/bin/wget}"
metrics_url="${OBSERVABILITY_METRICS_URL:-http://victoria-metrics.observability.svc.cluster.local:8428}"
logs_url="${OBSERVABILITY_LOGS_URL:-http://victoria-logs.observability.svc.cluster.local:9428}"
kubectl_bin="${KUBECTL:-kubectl}"

usage() {
    cat >&2 <<'EOF'
usage:
  observability-api health
  observability-api metrics query QUERY [TIME]
  observability-api metrics range QUERY START END STEP
  observability-api metrics labels [LABEL]
  observability-api logs query QUERY [START] [END] [LIMIT]
  observability-api logs hits QUERY [START] [END] [STEP]
  observability-api logs fields QUERY [START] [END]
  observability-api logs values QUERY FIELD [START] [END] [LIMIT]

defaults:
  log START=1h, END=now, LIMIT=100, hit STEP=5m

environment:
  KUBECTL                        kubectl executable
  OBSERVABILITY_TOOL_NAMESPACE  default: observability
  OBSERVABILITY_TOOL_TARGET     default: statefulset/victoria-metrics
  OBSERVABILITY_WGET            default: /usr/bin/wget in the target
  OBSERVABILITY_METRICS_URL     internal VictoriaMetrics URL
  OBSERVABILITY_LOGS_URL        internal VictoriaLogs URL
EOF
}

if ! command -v "$kubectl_bin" >/dev/null 2>&1; then
    echo "kubectl not found; run this helper through 'nix develop -c'" >&2
    exit 127
fi

urlencode() {
    local LC_ALL=C
    local value=$1 encoded='' char hex i

    for ((i = 0; i < ${#value}; i++)); do
        char=${value:i:1}
        case "$char" in
        [a-zA-Z0-9.~_-]) encoded+=$char ;;
        ' ') encoded+='+' ;;
        *)
            printf -v hex '%%%02X' "'$char"
            encoded+=$hex
            ;;
        esac
    done

    printf '%s' "$encoded"
}

form_data() {
    local data='' separator='' key value

    while (($#)); do
        key=$1
        value=$2
        shift 2
        data+="${separator}$(urlencode "$key")=$(urlencode "$value")"
        separator='&'
    done

    printf '%s' "$data"
}

cluster_get() {
    "$kubectl_bin" exec -n "$tool_namespace" "$tool_target" -- \
        "$remote_wget" -qO- "$1"
}

cluster_post() {
    local url=$1
    shift

    "$kubectl_bin" exec -n "$tool_namespace" "$tool_target" -- \
        "$remote_wget" -qO- --post-data "$(form_data "$@")" "$url"
}

validate_limit() {
    local limit=$1
    if [[ ! $limit =~ ^[0-9]+$ ]] || ((limit < 1 || limit > 1000)); then
        echo "LIMIT must be an integer between 1 and 1000" >&2
        exit 2
    fi
}

[[ $# -ge 1 ]] || {
    usage
    exit 2
}

area=$1
shift

case "$area" in
health)
    [[ $# -eq 0 ]] || {
        usage
        exit 2
    }
    printf 'VictoriaMetrics: '
    cluster_get "${metrics_url}/health"
    printf '\nVictoriaLogs: '
    cluster_get "${logs_url}/health"
    printf '\n'
    ;;
metrics)
    [[ $# -ge 1 ]] || {
        usage
        exit 2
    }
    action=$1
    shift
    case "$action" in
    query)
        [[ $# -ge 1 && $# -le 2 ]] || {
            usage
            exit 2
        }
        args=(query "$1")
        [[ $# -eq 1 ]] || args+=(time "$2")
        cluster_post "${metrics_url}/api/v1/query" "${args[@]}"
        ;;
    range)
        [[ $# -eq 4 ]] || {
            usage
            exit 2
        }
        cluster_post "${metrics_url}/api/v1/query_range" \
            query "$1" start "$2" end "$3" step "$4"
        ;;
    labels)
        [[ $# -le 1 ]] || {
            usage
            exit 2
        }
        if [[ $# -eq 0 ]]; then
            cluster_get "${metrics_url}/api/v1/labels"
        else
            [[ $1 =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]] || {
                echo "invalid Prometheus label name: $1" >&2
                exit 2
            }
            cluster_get "${metrics_url}/api/v1/label/$1/values"
        fi
        ;;
    *)
        usage
        exit 2
        ;;
    esac
    ;;
logs)
    [[ $# -ge 1 ]] || {
        usage
        exit 2
    }
    action=$1
    shift
    case "$action" in
    query)
        [[ $# -ge 1 && $# -le 4 ]] || {
            usage
            exit 2
        }
        query=$1
        start=${2:-1h}
        end=${3:-now}
        limit=${4:-100}
        validate_limit "$limit"
        cluster_post "${logs_url}/select/logsql/query" \
            query "$query" start "$start" end "$end" limit "$limit"
        ;;
    hits)
        [[ $# -ge 1 && $# -le 4 ]] || {
            usage
            exit 2
        }
        cluster_post "${logs_url}/select/logsql/hits" \
            query "$1" start "${2:-1h}" end "${3:-now}" step "${4:-5m}"
        ;;
    fields)
        [[ $# -ge 1 && $# -le 3 ]] || {
            usage
            exit 2
        }
        cluster_post "${logs_url}/select/logsql/field_names" \
            query "$1" start "${2:-1h}" end "${3:-now}"
        ;;
    values)
        [[ $# -ge 2 && $# -le 5 ]] || {
            usage
            exit 2
        }
        limit=${5:-100}
        validate_limit "$limit"
        cluster_post "${logs_url}/select/logsql/field_values" \
            query "$1" field "$2" start "${3:-1h}" end "${4:-now}" \
            limit "$limit"
        ;;
    *)
        usage
        exit 2
        ;;
    esac
    ;;
*)
    usage
    exit 2
    ;;
esac
