#!/usr/bin/env bash
set -euo pipefail

grafana_namespace="${OBSERVABILITY_GRAFANA_NAMESPACE:-grafana}"
grafana_target="${OBSERVABILITY_GRAFANA_TARGET:-deploy/grafana}"
metrics_url="${OBSERVABILITY_METRICS_URL:-http://victoria-metrics.observability.svc.cluster.local:8428}"
logs_url="${OBSERVABILITY_LOGS_URL:-http://victoria-logs.observability.svc.cluster.local:9428}"
kubectl_bin="${KUBECTL:-kubectl}"

usage() {
    cat >&2 <<'EOF'
usage:
  observability-api health
  observability-api metrics query QUERY [TIME]
  observability-api metrics range QUERY START END STEP
  observability-api metrics labels [LABEL]
  observability-api logs query QUERY [START] [END] [LIMIT]
  observability-api logs hits QUERY [START] [END] [STEP]
  observability-api logs fields QUERY [START] [END]
  observability-api logs values QUERY FIELD [START] [END] [LIMIT]

defaults:
  log START=1h, END=now, LIMIT=100, hit STEP=5m

environment:
  KUBECTL                         kubectl executable
  OBSERVABILITY_GRAFANA_NAMESPACE  default: grafana
  OBSERVABILITY_GRAFANA_TARGET     default: deploy/grafana
  OBSERVABILITY_METRICS_URL        internal VictoriaMetrics URL
  OBSERVABILITY_LOGS_URL           internal VictoriaLogs URL
EOF
}

if ! command -v "$kubectl_bin" >/dev/null 2>&1; then
    echo "kubectl not found; run this helper through 'nix develop -c'" >&2
    exit 127
fi

cluster_curl() {
    "$kubectl_bin" exec -n "$grafana_namespace" "$grafana_target" -- \
        curl "$@"
}

validate_limit() {
    local limit=$1
    if [[ ! $limit =~ ^[0-9]+$ ]] || ((limit < 1 || limit > 1000)); then
        echo "LIMIT must be an integer between 1 and 1000" >&2
        exit 2
    fi
}

[[ $# -ge 1 ]] || {
    usage
    exit 2
}

area=$1
shift

case "$area" in
health)
    [[ $# -eq 0 ]] || {
        usage
        exit 2
    }
    printf 'VictoriaMetrics: '
    cluster_curl -fsS "${metrics_url}/health"
    printf '\nVictoriaLogs: '
    cluster_curl -fsS "${logs_url}/health"
    printf '\n'
    ;;
metrics)
    [[ $# -ge 1 ]] || {
        usage
        exit 2
    }
    action=$1
    shift
    case "$action" in
    query)
        [[ $# -ge 1 && $# -le 2 ]] || {
            usage
            exit 2
        }
        args=(-fsS -G "${metrics_url}/api/v1/query" --data-urlencode "query=$1")
        [[ $# -eq 1 ]] || args+=(--data-urlencode "time=$2")
        cluster_curl "${args[@]}"
        ;;
    range)
        [[ $# -eq 4 ]] || {
            usage
            exit 2
        }
        cluster_curl -fsS -G "${metrics_url}/api/v1/query_range" \
            --data-urlencode "query=$1" \
            --data-urlencode "start=$2" \
            --data-urlencode "end=$3" \
            --data-urlencode "step=$4"
        ;;
    labels)
        [[ $# -le 1 ]] || {
            usage
            exit 2
        }
        if [[ $# -eq 0 ]]; then
            cluster_curl -fsS "${metrics_url}/api/v1/labels"
        else
            [[ $1 =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]] || {
                echo "invalid Prometheus label name: $1" >&2
                exit 2
            }
            cluster_curl -fsS "${metrics_url}/api/v1/label/$1/values"
        fi
        ;;
    *)
        usage
        exit 2
        ;;
    esac
    ;;
logs)
    [[ $# -ge 1 ]] || {
        usage
        exit 2
    }
    action=$1
    shift
    case "$action" in
    query)
        [[ $# -ge 1 && $# -le 4 ]] || {
            usage
            exit 2
        }
        query=$1
        start=${2:-1h}
        end=${3:-now}
        limit=${4:-100}
        validate_limit "$limit"
        cluster_curl -fsS -G "${logs_url}/select/logsql/query" \
            --data-urlencode "query=$query" \
            --data-urlencode "start=$start" \
            --data-urlencode "end=$end" \
            --data-urlencode "limit=$limit"
        ;;
    hits)
        [[ $# -ge 1 && $# -le 4 ]] || {
            usage
            exit 2
        }
        cluster_curl -fsS -G "${logs_url}/select/logsql/hits" \
            --data-urlencode "query=$1" \
            --data-urlencode "start=${2:-1h}" \
            --data-urlencode "end=${3:-now}" \
            --data-urlencode "step=${4:-5m}"
        ;;
    fields)
        [[ $# -ge 1 && $# -le 3 ]] || {
            usage
            exit 2
        }
        cluster_curl -fsS -G "${logs_url}/select/logsql/field_names" \
            --data-urlencode "query=$1" \
            --data-urlencode "start=${2:-1h}" \
            --data-urlencode "end=${3:-now}"
        ;;
    values)
        [[ $# -ge 2 && $# -le 5 ]] || {
            usage
            exit 2
        }
        limit=${5:-100}
        validate_limit "$limit"
        cluster_curl -fsS -G "${logs_url}/select/logsql/field_values" \
            --data-urlencode "query=$1" \
            --data-urlencode "field=$2" \
            --data-urlencode "start=${3:-1h}" \
            --data-urlencode "end=${4:-now}" \
            --data-urlencode "limit=$limit"
        ;;
    *)
        usage
        exit 2
        ;;
    esac
    ;;
*)
    usage
    exit 2
    ;;
esac
